# Salin ke .env lalu isi. Jangan commit .env.
# Buat semua secret sekaligus:  npm run secrets

LRS_HOST=0.0.0.0
LRS_PORT=4200
# Token untuk aplikasi web di garis start (HP/Laptop). Diisi di menu Pengaturan aplikasi.
LRS_STARTER_TOKEN=
# Token untuk sts-timingsystem (LRS_TIMING_TOKEN di .env timing / longrange.json).
LRS_TIMING_TOKEN=
# Sama persis dengan LRS_HMAC_SECRET di sts-timingsystem. TIDAK pernah dikirim ke HP.
LRS_HMAC_SECRET=
# Origin yang boleh memanggil API (koma). * = semua. Contoh: https://start.domain.com
LRS_CORS_ORIGINS=*
# Start yang belum diterima timing dikirim ulang saat timing tersambung, maksimal sekian jam ke belakang.
LRS_REDELIVER_HOURS=12
# LRS_DATA_DIR=./data
